      "id": "b2",
      "name": "Read Approved Drafts",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const seen = new Set();\nconst out = [];\nfor (const item of $input.all()) {\n  const row = item.json;\n  if (row.status !== 'approved' || seen.has(row.text)) continue;\n  seen.add(row.text);\n  out.push({ json: row });\n}\nreturn out.slice(0, 3);"
      },
      "id": "b3",
      "name": "Filter Approved",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "text": "={{ $json.text }}",
        "additionalFields": {}
      },
      "id": "b4",
      "name": "Post to X",
      "type": "n8n-nodes-base.twitter",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => ({ json: { ...item.json, status: 'posted', postedAt: new Date().toISOString() } }));"
      },
