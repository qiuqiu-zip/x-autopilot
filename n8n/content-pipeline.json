{
  "name": "AI Content Pipeline for X (draft → approve → post)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "a1",
      "name": "Daily 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://techcrunch.com/category/artificial-intelligence/feed/",
        "options": {}
      },
      "id": "a2",
      "name": "AI News RSS",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst keywords = ['agent', 'model', 'open source', 'automation', 'claude', 'gpt', 'llm', 'pricing'];\nconst scored = items.map(item => {\n  const text = (item.json.title || '') + ' ' + (item.json.contentSnippet || '');\n  const score = keywords.reduce((s, k) => s + (text.toLowerCase().includes(k) ? 10 : 0), 0) + (text.length > 80 ? 5 : 0);\n  return { json: { title: item.json.title, link: item.json.link, score } };\n});\nscored.sort((a, b) => b.json.score - a.json.score);\nreturn scored.slice(0, 5);"
      },
      "id": "a3",
      "name": "Score Topics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://open.bigmodel.cn/api/paas/v4/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'glm-4-flash', messages: [ { role: 'system', content: 'You write punchy X posts. Max 260 characters. Include one concrete number or example.' }, { role: 'user', content: 'Write an X post about this news, add your take: ' + $json.title + ' ' + $json.link } ], temperature: 0.8 }) }}"
      },
      "id": "a4",
      "name": "LLM Draft Posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const choices = item.json.choices || [];\n  const text = choices[0] && choices[0].message ? choices[0].message.content.trim() : '';\n  if (text && text.length <= 280) out.push({ json: { status: 'pending', text, created: new Date().toISOString() } });\n}\nreturn out;"
      },
      "id": "a5",
      "name": "Format & Filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Drafts",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData"
        }
      },
      "id": "a6",
      "name": "Drafts → Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "YOUR_CHAT_ID",
        "text": "=📝 {{ $json.text.substring(0, 80) }}... ready for review"
      },
      "id": "a7",
      "name": "Telegram Notify",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1320,
        0
      ]
    },
    {
      "parameters": {
